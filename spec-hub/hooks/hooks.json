{
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/changes.sh\" start", "timeout": 5 },
      { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cleanup.sh\" start", "timeout": 10 }
    ] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/changes.sh\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "mcp__.*__set_card", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cleanup.sh\" card", "timeout": 10 }] }]
  }
}
